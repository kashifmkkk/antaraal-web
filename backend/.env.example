# Database Configuration (MySQL/MariaDB for GoDaddy)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for GoDaddy: DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/your_database_name"
DATABASE_URL="mysql://root:password@localhost:3306/antaraal"

# Server Configuration
PORT=4000
HOST=0.0.0.0

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET="change_this_secret_in_production"

# Node Environment
NODE_ENV=production
